# ─── Large Data Files ─────────────────────────────────────────────────────────
# Sentinel-2 image patches (~3500 .npy files, ~2GB+)
SentinelPatches/

# GeoTIFF exports from Google Earth Engine
GangaIndices/

# Processed data (regenerated by pipeline scripts)
GangaIndices_All/satellite_indices.csv
GangaIndices_All/water_quality_daily.csv
GangaIndices_All/merged_bn_dataset.csv
GangaIndices_All/checkpoint.json

# Training dataset patches (large binary files)
training_dataset/patches/
training_dataset/patches.zip
training_dataset/*.csv
training_dataset/checkpoint*.json

# Raw HTML data files (too large, not needed in repo)
NWMP data/

# PDF-extracted tables (349 CSVs — regenerated by pipeline)
data/raw/pdf_extracted/

# Raw PDFs (large, can be downloaded from CPCB)
data/raw/cpcb/nwmp_pdfs/
data/raw/cpcb/discovered_files/

# Web-scraped intermediate data
data/web_extracted/

# Hourly data dumps (regenerated)
data/Hourly_data/
data/Hourly_data_processed/
data/rtwqms_historical/

# Intermediate CSVs at data root (final outputs are in data/final_v2/)
data/combined_station_data.csv
data/combined_station_data_with_coords.csv

# ─── Model Weights (too large for Git; provide download link) ─────────────────
*.pt
*.pth
*.onnx
*.h5

# ─── Outputs (regenerated by scripts) ─────────────────────────────────────────
outputs/
*.zip

# ─── Documents (binary files, not suitable for Git) ───────────────────────────
docs/*.pptx
docs/*.pdf
docs/generated/

# ─── Results (regenerated by training scripts) ────────────────────────────────
GangaIndices_All/results/models/
GangaIndices_All/results_cnn/models/
training_dataset/results/
training_dataset/results_cnn/
training_dataset/results_generic/

